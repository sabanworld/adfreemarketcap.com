APP_NAME=adfreemarketcap.com
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Admin panel MFA (authenticator app). Defaults to required when APP_ENV=production.
# ADMIN_MFA_REQUIRED=true

# Error monitoring (Sentry). Leave empty locally; set the project DSN in production.
# The Laravel SDK reports from the server only. No Sentry script loads in the browser.
SENTRY_LARAVEL_DSN=
# Cron monitors (`->sentryMonitor()`). Defaults to on only when APP_ENV=production.
# SENTRY_CRON_MONITORING=false
# SENTRY_SEND_DEFAULT_PII=false
# SENTRY_TRACES_SAMPLE_RATE=

# Sail / local stack (compose service hosts). Defaults in config/ assume sqlite + 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=adfreemarketcap
DB_USERNAME=sail
DB_PASSWORD=password

LOG_STACK=single

SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PASSWORD=null

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=

VITE_APP_NAME="${APP_NAME}"

# Optional SEO overrides. Defaults live in config/seo.php.
SEO_OG_IMAGE=
SEO_TWITTER_SITE=

# Optional company overrides. Defaults live in config/company.php.
COMPANY_VAT=
COMPANY_HOSTING_TRANSFER=
COMPANY_MAIL_PROVIDER=

# Mining block, analytics, consent, form rate limits, currency, and most
# market-data / Nostr tuning: defaults live in config/mining.php,
# config/analytics.php, config/consent.php, config/forms.php,
# config/currency.php, config/marketdata.php, config/networks.php,
# config/nostr.php, and config/exchange-widget.php.

# Visitor statistics (Plausible). On by default when APP_ENV=production.
# See config/analytics.php. Disclosed in the privacy and cookie policies.

# Google Ads conversion measurement. Config default is off; both values below
# must be filled before it renders. Needs consent. Switching it on rewrites
# the privacy policy, the cookie policy, the Why ad-free page, and the bar.
GOOGLE_ADS_ENABLED=true
GOOGLE_ADS_CONVERSION_ID=AW-18451487610
GOOGLE_ADS_CONVERSION_REGISTRATION=
GOOGLE_ADS_CONVERSION_WATCHLIST=

# ChangeNOW affiliate swap widget defaults (enabled + link id) live in
# config/exchange-widget.php. Needs the same consent as Google Ads.

ALTCHA_HMAC_SECRET=
ALTCHA_HMAC_KEY_SECRET=

WWWUSER=1000
WWWGROUP=1000

# Host-published ports (compose defaults differ; these avoid common collisions).
APP_PORT=8888
VITE_PORT=5174
FORWARD_DB_PORT=13306
FORWARD_REDIS_PORT=6380
FORWARD_MAILPIT_PORT=1026
FORWARD_MAILPIT_DASHBOARD_PORT=8026

COINGECKO_API_KEY=
# Demo (free) key: x-cg-demo-api-key + https://api.coingecko.com/api/v3
# Paid key:        x-cg-pro-api-key  + https://pro-api.coingecko.com/api/v3
# Override header / base URL in config/marketdata.php (or set
# COINGECKO_API_KEY_HEADER / COINGECKO_BASE_URL). They must match the plan.
# Shared Pro quota with Dex onchain: brief 429 backoff for charts/details.
# COINGECKO_RETRY_TIMES=4
# COINGECKO_RETRY_SLEEP_MS=250
COINMARKETCAP_API_KEY=
# Crypto APIs serves CoinMarketCap figures and is the source for the 1h and 7d
# percentages. Leave empty to keep the CoinGecko values.
CRYPTO_APIS_IO_KEY=
# Optional Dex override. Falls back to COINGECKO_API_KEY when empty.
# GECKOTERMINAL_API_KEY=

# Aligns company.php retention copy with nostr.php (their env defaults differ).
NOSTR_RETENTION_DAYS=90

BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log
