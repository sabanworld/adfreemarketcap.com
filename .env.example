APP_NAME=adfreemarketcap.com
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Admin panel MFA (authenticator app). Defaults to required when APP_ENV=production.
# ADMIN_MFA_REQUIRED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error monitoring (Sentry). Leave empty locally; set the project DSN in production.
# The Laravel SDK reports from the server only. No Sentry script loads in the browser.
SENTRY_LARAVEL_DSN=
# Cron monitors (`->sentryMonitor()`). Defaults to on only when APP_ENV=production.
# SENTRY_CRON_MONITORING=false
# SENTRY_SEND_DEFAULT_PII=false
# SENTRY_TRACES_SAMPLE_RATE=

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=adfreemarketcap
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=130

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SEO_DEFAULT_DESCRIPTION="Ad-free cryptocurrency market rankings, prices, market caps, and coin details. No ads, no clutter."
SEO_OG_IMAGE=
SEO_TWITTER_SITE=
SEO_SITEMAP_CACHE_SECONDS=600

COMPANY_LEGAL_NAME="The Saban Company B.V."
COMPANY_LEGAL_FORM="Besloten vennootschap (B.V.)"
COMPANY_KVK=91125030
COMPANY_VAT=
COMPANY_WEBSITE=https://the.saban.company/en
# Named in product copy instead of "the creator". Legal pages name the company.
COMPANY_PERSON="Anees®"
COMPANY_CONTACT_EMAIL=hello@the.saban.company
COMPANY_PRIVACY_EMAIL=
COMPANY_POLICIES_UPDATED_AT="14 September 2026"
COMPANY_RETENTION_ACCOUNT_DAYS=30
COMPANY_RETENTION_LOG_DAYS=90
COMPANY_HOSTING_PROVIDER="DigitalOcean, LLC"
COMPANY_HOSTING_LOCATION="Amsterdam, the Netherlands (AMS3), with support access from the United States"
COMPANY_HOSTING_TRANSFER="EU standard contractual clauses and the EU-US Data Privacy Framework"
COMPANY_SERVER_MANAGEMENT_PROVIDER="Ploi (WebBuilds B.V.)"
COMPANY_SERVER_MANAGEMENT_LOCATION="The Netherlands"
COMPANY_MAIL_PROVIDER=
COMPANY_MAIL_LOCATION="European Union"
COMPANY_ERROR_MONITORING_PROVIDER="Functional Software, Inc. (Sentry)"
COMPANY_ERROR_MONITORING_LOCATION="United States, with optional EU data residency depending on project settings"
COMPANY_ERROR_MONITORING_TRANSFER="EU standard contractual clauses and the EU-US Data Privacy Framework"
COMPANY_BTC_DONATION_ADDRESS=bc1qqaez603xp44gzl3ds4j4am62yp8sp2lhkz30ah

# Miners block on the home page. The partner named here is disclosed on the block
# itself, so read docs/privacy-and-legal.md before changing the partner or copy.
MINING_BLOCK_ENABLED=true
# Coin pages that show the block, by slug or symbol. The home page always shows it.
MINING_COINS=bitcoin,btc
MINING_PARTNER_NAME=Rigly
MINING_PARTNER_PRODUCT=Blockparty
MINING_PARTNER_URL=https://blockparty.rigly.io
MINING_MIN_BID_SATS=1000
MINING_LAST_BLOCK_HEIGHT=955703
MINING_LAST_BLOCK_FOUND_AT="June 2026"
MINING_LAST_BLOCK_HASH=00000000000000000001089806eb0365ac250e44bc0b306ba0339a6b63c63fc5
MINING_LAST_BLOCK_EXPLORER=https://mempool.space/block

# Visitor statistics (Plausible). Off unless set, and on by default when
# APP_ENV=production. The tracker is bundled by Vite rather than fetched from
# plausible.io, and ANALYTICS_DOMAIN is the site name in the Plausible
# dashboard. The counter is disclosed in the privacy and cookie policies, so
# read docs/privacy-and-legal.md before changing these.
ANALYTICS_ENABLED=false
ANALYTICS_DOMAIN=adfreemarketcap.com
ANALYTICS_ENDPOINT=https://plausible.io/api/event

# Leave this false and a browser sending Do Not Track or Global Privacy Control
# loads no tracker at all, which is what the privacy policy promises.
ANALYTICS_COLLECT_DNT=false

# Counted besides page views. Each one is named in the privacy policy, so turn
# one off and that copy changes with it.
ANALYTICS_CAPTURE_OUTBOUND_LINKS=true
ANALYTICS_CAPTURE_FILE_DOWNLOADS=true
ANALYTICS_CAPTURE_FORM_SUBMISSIONS=true

# Google Ads conversion measurement. This is the only tag on the site that needs
# consent, so it stays off until the visitor accepts in the cookie bar, and both
# values below must be filled before it renders at all. Switching it on rewrites
# the privacy policy, the cookie policy, the Why ad-free page, and the bar, so
# read docs/privacy-and-legal.md first.
GOOGLE_ADS_ENABLED=true
GOOGLE_ADS_CONVERSION_ID=AW-18451487610
GOOGLE_ADS_SCRIPT_URL=https://www.googletagmanager.com/gtag/js

# Conversion labels from Google Ads, without the AW- prefix (the ID above is
# prepended). Leave a label empty and that conversion is simply not reported.
GOOGLE_ADS_CONVERSION_REGISTRATION=
GOOGLE_ADS_CONVERSION_WATCHLIST=

# Bump in the same release as the consent purposes, so stored answers expire and
# the cookie bar asks everyone again.
CONSENT_VERSION=2026-09-14

ALTCHA_ENABLED=true
ALTCHA_HMAC_SECRET=
ALTCHA_HMAC_KEY_SECRET=
ALTCHA_COST=10000
ALTCHA_EXPIRES=300

FORM_RATE_LIMIT_LOGIN=5
FORM_RATE_LIMIT_LOGIN_DECAY=60
FORM_RATE_LIMIT_REGISTER=3
FORM_RATE_LIMIT_REGISTER_DECAY=60
FORM_RATE_LIMIT_LOGOUT=10
FORM_RATE_LIMIT_LOGOUT_DECAY=60
FORM_RATE_LIMIT_WATCH_TOGGLE=30
FORM_RATE_LIMIT_WATCH_TOGGLE_DECAY=60
FORM_RATE_LIMIT_CURRENCY=30
FORM_RATE_LIMIT_CURRENCY_DECAY=60
FORM_RATE_LIMIT_ALTCHA=60
FORM_RATE_LIMIT_ALTCHA_DECAY=60

WWWUSER=1000
WWWGROUP=1000

APP_PORT=8888
VITE_PORT=5174
FORWARD_DB_PORT=13306
FORWARD_REDIS_PORT=6380
FORWARD_MAILPIT_PORT=1026
FORWARD_MAILPIT_DASHBOARD_PORT=8026

MARKETDATA_PRIMARY=coingecko
MARKETDATA_FAILOVER=coinpaprika
COINGECKO_API_KEY=
# Demo (free) key: x-cg-demo-api-key + https://api.coingecko.com/api/v3
# Paid key:        x-cg-pro-api-key  + https://pro-api.coingecko.com/api/v3
# The header and base URL must match the plan, or CoinGecko answers
# 401 {"error_code":10002,"error_message":"API Key Missing"}.
COINGECKO_API_KEY_HEADER=x-cg-demo-api-key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1
COINMARKETCAP_API_KEY=
# Crypto APIs serves CoinMarketCap figures and is the source for the 1h and 7d
# percentages, because CoinGecko rounds those to 0.1 on /coins/markets. Leave
# the key empty to keep the CoinGecko values.
CRYPTO_APIS_IO_KEY=
CRYPTO_APIS_IO_BASE_URL=https://rest.cryptoapis.io
CRYPTO_APIS_IO_PER_PAGE=50
CRYPTO_APIS_IO_MAX_PAGES=5
# Space and retry page calls so a credit burst does not trip 429 throughput_limit_reached.
CRYPTO_APIS_IO_PAGE_DELAY_MS=250
CRYPTO_APIS_IO_RETRY_TIMES=4
CRYPTO_APIS_IO_RETRY_SLEEP_MS=250
MARKETDATA_MARKETS_PAGES=2
MARKETDATA_PER_PAGE=100
MARKETDATA_MARKETS_INTERVAL=10
MARKETDATA_DETAIL_STALE_HOURS=6
# Coin detail (description) is refreshed on visit. These keys also
# walk the top of the ranking so popular coins always have a description: how far
# down the ranking to look, how many coins per run, and how often a run fires.
MARKETDATA_DETAIL_BACKFILL_COINS=20
MARKETDATA_DETAIL_BACKFILL_BATCH=3
MARKETDATA_DETAIL_BACKFILL_INTERVAL=60
MARKETDATA_DIVERGENCE_THRESHOLD=5
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_API_KEY=
GECKOTERMINAL_API_KEY_HEADER=x-cg-pro-api-key
MARKETDATA_DEX_INTERVAL=5
MARKETDATA_DEX_TRENDING_PAGES=1
MARKETDATA_DEX_NEW_PAGES=1
MARKETDATA_DEX_NETWORKS=
MARKETDATA_INSIGHTS_INTERVAL_HOURS=6
# Exchange tickers: hot majors every MARKETDATA_HOT_TICKERS_INTERVAL minutes.
# Set MARKETDATA_TICKERS_TOP_COINS>0 to also schedule a broad top-N job.
MARKETDATA_HOT_COINS=bitcoin,ethereum,dogecoin,litecoin,bitcoin-cash,ripple,zcash
MARKETDATA_HOT_TICKERS_INTERVAL=5
# Multi-range charts: three CoinGecko series (intraday/short/daily). Hot majors
# refresh on MARKETDATA_HOT_CHARTS_INTERVAL; other coins sync on visit.
MARKETDATA_HOT_CHARTS_INTERVAL=60
MARKETDATA_CHART_INTRADAY_STALE_MINUTES=30
MARKETDATA_CHART_SHORT_STALE_MINUTES=120
MARKETDATA_CHART_DAILY_STALE_MINUTES=720
MARKETDATA_TICKERS_STALE_MINUTES=45
MARKETDATA_TICKERS_PAGES=1
MARKETDATA_TICKERS_TOP_COINS=0
MARKETDATA_TICKERS_INTERVAL=15
# Market status: Fear & Greed (Alternative.me), AFMC10 basket, altcoin season.
ALTERNATIVE_ME_BASE_URL=https://api.alternative.me
MARKETDATA_STATUS_INTERVAL=60
MARKETDATA_AFMC10=bitcoin,ethereum,dogecoin,litecoin,bitcoin-cash,ripple,binancecoin,hedera-hashgraph,near,sui
MARKETDATA_ALTCOIN_SEASON_TOP_N=50
MARKETDATA_ALTCOIN_SEASON_EXCLUDE=USDT,USDC,DAI,FDUSD,USDE,USDS,BUSD,TUSD,USDD,PYUSD,EURC,WBTC,WETH,STETH,WSTETH,WEETH,CBETH,RETH,TBTC,BTCB
# The 90-day change behind altcoin season is derived from chart history, because no ranking
# endpoint reports that window. One request per sampled coin: the job runs hourly but only touches
# coins older than the stale window, so in practice one run a day does the work. The budget caps
# fetching per run and must stay under REDIS_QUEUE_RETRY_AFTER, or a slow run is handed to a second
# worker as well. Set the budget to 0 to pause the requests without changing the schedule.
MARKETDATA_NINETY_DAY_INTERVAL=60
MARKETDATA_NINETY_DAY_STALE_HOURS=20
MARKETDATA_NINETY_DAY_BUDGET_SECONDS=90
MARKETDATA_ALTCOIN_SEASON_MIN_HISTORY_DAYS=80
# CoinGecko asset platforms for Markets network filter.
MARKETDATA_PLATFORMS_INTERVAL_HOURS=24
MARKETDATA_NETWORK_PINNED=ethereum,binance-smart-chain,solana,base
MARKETDATA_NETWORK_HIDDEN=
# Nostr community remarks (server-side HTTP gateways only).
# Divine is tried first; api.nostr.band is a fallback (often times out from some hosts).
NOSTR_DIVINE_BASE_URL=https://gateway.divine.video
NOSTR_API_BASE_URL=https://api.nostr.band
NOSTR_HTTP_TIMEOUT=12
NOSTR_HTTP_CONNECT_TIMEOUT=5
NOSTR_EVENT_LINK_BASE=https://primal.net/e
NOSTR_RETENTION_DAYS=90
NOSTR_MAX_AGE_DAYS=90
NOSTR_TOPIC_LEAD_CHARS=160
NOSTR_NOTES_PER_AUTHOR=40
NOSTR_DISPLAY_LIMIT=8
NOSTR_STALE_MINUTES=45
MARKETDATA_NOSTR_INTERVAL=30
CURRENCY_DEFAULT=usd
CURRENCY_RATES_INTERVAL=30
CURRENCY_RATES_CACHE_SECONDS=300
CURRENCY_RATES_STALE_MINUTES=180
BITCOIN_CHARTS_BASE_URL=https://charts.bitcoin.com/api/v1
BITCOIN_CHARTS_PI_CYCLE_TIMESPAN=1y
BITCOIN_CHARTS_PI_CYCLE_LIMIT=365
